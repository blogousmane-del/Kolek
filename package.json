{
  "name": "kolek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kolek — SaaS de gestion pour banquiers ambulants",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:env": "node scripts/env-test.mjs",
    "test:db": "npm run db:env && vitest run --config supabase/tests/vitest.config.ts",
    "test:scripts": "vitest run --dir scripts",
    "verifier:bundles": "node scripts/verifier-bundles.mjs",
    "verifier:champs": "node scripts/verifier-champs.mjs",
    "verifier:config": "node scripts/verifier-config.mjs",
    "verifier:lint": "npm run lint --workspaces --if-present && oxlint packages scripts",
    "verifier:derive": "node scripts/verifier-derive.mjs",
    "verifier:dns": "node scripts/verifier-dns.mjs",
    "verifier:exemples-env": "node scripts/verifier-exemples-env.mjs",
    "verifier:manifeste": "node scripts/verifier-manifeste.mjs",
    "verifier:en-ligne": "node scripts/verifier-en-ligne.mjs",
    "verifier:migrations": "node scripts/verifier-migrations.mjs",
    "verifier:portillons": "node scripts/verifier-portillons.mjs",
    "verifier:promos": "node scripts/verifier-promos.mjs",
    "generer:theme": "node scripts/generer-theme.mjs",
    "verifier:theme": "node scripts/generer-theme.mjs --verifier",
    "generer:marque": "node scripts/generer-marque.mjs",
    "verifier:marque": "node scripts/generer-marque.mjs --verifier",
    "verifier": "npm run db:reset && npm run verifier:theme && npm run verifier:marque && npm run verifier:paliers && npm run verifier:champs && npm run verifier:exemples-env && npm run verifier:manifeste && npm run verifier:portillons && npm run verifier:lint && npm run typecheck --workspaces --if-present && npm test && npm run test:scripts && npm run test:db && npm run build && npm run verifier:bundles",
    "generer:paliers": "node scripts/generer-paliers-edge.mjs",
    "verifier:paliers": "node scripts/generer-paliers-edge.mjs --verifier"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.112.3",
    "vitest": "^4.1.10"
  }
}
