DRAINAGE_SECRET=test_local_seulement_ce_secret_n_ouvre_rien
CHARIOW_SECRET_WEBHOOK=test_local_seulement_ce_secret_n_ouvre_rien_webhook
CHARIOW_SECRET_SIGNATURE=test_local_seulement_cette_signature_n_ouvre_rien

# La table des produits Chariow, pour la pile locale et le CI seulement.
# Sans elle, `lireProduits` jette « CHARIOW_PRODUITS absent » et
# `abonnement-payer` rend CONFIGURATION 500 avant meme de lire la saisie :
# le refus de version et l ecriture de l acceptation devenaient
# inatteignables, et trois epreuves rouges au CI le disaient.
# Identifiants volontairement faux : ce fichier est versionne, et la vente
# reste hors d'atteinte faute de CHARIOW_CLE_API.
CHARIOW_PRODUITS={"standard":"prod_faux_standard","pro":"prod_faux_pro","illimite":"prod_faux_illimite"}
