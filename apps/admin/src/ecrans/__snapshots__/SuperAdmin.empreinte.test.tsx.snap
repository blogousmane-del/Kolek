exports[`empreinte du rendu, avant et après le découpage > l’onglet administrateurs rend exactement le même DOM 1`] = `"<div class="bg-canvas px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-4 flex-shrink-0"><div class="flex items-center gap-1.5 mb-2"><span class="flex items-center gap-1.5"><span class="text-sm font-body text-muted-foreground">Super Admin</span></span><span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="text-sm font-body text-ink font-medium">Administrateurs</span></span></div><div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"><h1 class="font-headings font-bold text-2xl sm:text-3xl text-ink">Administrateurs</h1><div class="flex items-center flex-wrap gap-2"><button type="button" aria-label="Rafraîchir" title="Rafraîchir" class="flex items-center gap-2 min-h-11 px-3 sm:px-4 rounded-md text-base font-body font-medium border bg-surface text-ink border-hairline cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="hidden sm:inline">Rafraîchir</span></button></div></div></div><div class="px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6 overflow-y-auto"><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Administrateurs</h2><p class="font-body text-sm text-muted-foreground mb-3">Un super administrateur voit et modifie cet écran. Un administrateur ordinaire ne le voit pas.</p><div class="bg-surface rounded-lg border border-hairline shadow-sm divide-y divide-hairline"><div data-testid="admin-11111111-1111-4111-8111-111111111111" class="p-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div class="min-w-0"><p class="font-body font-semibold text-ink truncate">Aya Konan<span class="ml-2 px-2 py-0.5 rounded-pill bg-secondary text-secondary-foreground text-xs font-semibold">C'est toi</span></p><p class="font-body text-sm text-muted-foreground">Super administrateur · +2250700000001 · depuis le 5 janv. 2026</p></div></div><div data-testid="admin-22222222-2222-4222-8222-222222222222" class="p-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div class="min-w-0"><p class="font-body font-semibold text-ink truncate">Bakary Touré</p><p class="font-body text-sm text-muted-foreground">Administrateur · +2250700000002 · depuis le 12 juin 2026, ajouté par Aya Konan</p></div><div class="flex gap-2 flex-shrink-0"><button type="button" class="anim-pression min-h-11 px-5 rounded-md font-body font-semibold text-base flex items-center justify-center gap-2 bg-surface text-primary border border-primary  cursor-pointer ">Promouvoir</button><button type="button" class="anim-pression min-h-11 px-5 rounded-md font-body font-semibold text-base flex items-center justify-center gap-2 bg-transparent text-primary border border-transparent  cursor-pointer ">Révoquer</button></div></div></div></section></div>"`;

exports[`empreinte du rendu, avant et après le découpage > l’onglet paiement rend exactement le même DOM 1`] = `"<div class="bg-canvas px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-4 flex-shrink-0"><div class="flex items-center gap-1.5 mb-2"><span class="flex items-center gap-1.5"><span class="text-sm font-body text-muted-foreground">Super Admin</span></span><span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="text-sm font-body text-ink font-medium">Paiement</span></span></div><div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"><h1 class="font-headings font-bold text-2xl sm:text-3xl text-ink">Paiement des abonnements</h1><div class="flex items-center flex-wrap gap-2"><button type="button" aria-label="Rafraîchir" title="Rafraîchir" class="flex items-center gap-2 min-h-11 px-3 sm:px-4 rounded-md text-base font-body font-medium border bg-surface text-ink border-hairline cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="hidden sm:inline">Rafraîchir</span></button></div></div></div><div class="px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6 overflow-y-auto"><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Paiement des abonnements</h2><div class="bg-surface rounded-lg border border-hairline shadow-sm p-5"><p class="font-body text-sm text-muted-foreground">La fonction <code>super-admin-etat</code> en ligne ne rend pas encore l’état du paiement. Redéploie-la pour que cet écran ait quelque chose à lire.</p></div></section></div>"`;

exports[`empreinte du rendu, avant et après le découpage > l’onglet paiement, configuré, rend exactement le même DOM 1`] = `"<div class="bg-canvas px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-4 flex-shrink-0"><div class="flex items-center gap-1.5 mb-2"><span class="flex items-center gap-1.5"><span class="text-sm font-body text-muted-foreground">Super Admin</span></span><span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="text-sm font-body text-ink font-medium">Paiement</span></span></div><div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"><h1 class="font-headings font-bold text-2xl sm:text-3xl text-ink">Paiement des abonnements</h1><div class="flex items-center flex-wrap gap-2"><button type="button" aria-label="Rafraîchir" title="Rafraîchir" class="flex items-center gap-2 min-h-11 px-3 sm:px-4 rounded-md text-base font-body font-medium border bg-surface text-ink border-hairline cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="hidden sm:inline">Rafraîchir</span></button></div></div></div><div class="px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6 overflow-y-auto"><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Paiement des abonnements</h2><p class="font-body text-sm text-muted-foreground mb-3">Aucune clé ne se saisit ici, et il n’y a pas de champ pour ça. Une clé qui encaisse vit dans les secrets des Edge Functions — <code>npx supabase secrets set</code>, voir <code>Docs/deploiement.md</code> §7. Cet écran dit ce qui est posé et si la boutique l’accepte, jamais ce que valent les secrets.</p><div data-testid="paiement"><div class="bg-surface rounded-lg border border-hairline shadow-sm p-5 space-y-5"><div><p class="font-body text-sm font-semibold text-ink mb-2">Ce qui est déclaré</p><dl class="space-y-2.5"><div class="flex items-center justify-between gap-4"><dt class="font-body text-sm text-muted-foreground">Clé d’API <code>CHARIOW_CLE_API</code></dt><dd class="flex items-center gap-2"><span class="font-body text-xs text-muted-foreground tabular-nums">…MNOP</span><span class="px-2.5 py-1 rounded-pill text-xs font-body font-semibold whitespace-nowrap bg-positive-tint text-positive">Posée</span></dd></div><div class="flex items-center justify-between gap-4"><dt class="font-body text-sm text-muted-foreground">Secret de webhook <code>CHARIOW_SECRET_WEBHOOK</code></dt><dd><span class="px-2.5 py-1 rounded-pill text-xs font-body font-semibold whitespace-nowrap bg-positive-tint text-positive">Posé</span></dd></div><div class="flex items-start justify-between gap-4"><dt class="font-body text-sm text-muted-foreground">Produits <code>CHARIOW_PRODUITS</code></dt><dd class="flex flex-wrap justify-end gap-1.5"><span class="px-2.5 py-1 rounded-pill text-xs font-body font-semibold whitespace-nowrap bg-positive-tint text-positive">standard</span><span class="px-2.5 py-1 rounded-pill text-xs font-body font-semibold whitespace-nowrap bg-positive-tint text-positive">pro</span><span class="px-2.5 py-1 rounded-pill text-xs font-body font-semibold whitespace-nowrap bg-positive-tint text-positive">illimite</span></dd></div></dl></div><div class="border-t border-hairline pt-4"><p class="font-body text-sm font-semibold text-ink mb-2">Ce que la boutique répond</p><p role="status" class="font-body text-sm text-positive">La boutique répond et accepte la clé.</p><p class="font-body text-xs text-muted-foreground mt-2">Mesuré à l’ouverture de cet écran, par un <code>GET /products</code> chez Chariow — la lecture la plus inoffensive du contrat. Trois secondes d’attente au plus : une boutique en panne ne doit pas empêcher d’afficher la page où l’on vient justement voir ce qui ne va pas.</p></div></div></div></section></div>"`;

exports[`empreinte du rendu, avant et après le découpage > l’onglet plateforme rend exactement le même DOM 1`] = `"<div class="bg-canvas px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-4 flex-shrink-0"><div class="flex items-center gap-1.5 mb-2"><span class="flex items-center gap-1.5"><span class="text-sm font-body text-muted-foreground">Super Admin</span></span><span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="text-sm font-body text-ink font-medium">Plateforme</span></span></div><div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"><h1 class="font-headings font-bold text-2xl sm:text-3xl text-ink">Plateforme</h1><div class="flex items-center flex-wrap gap-2"><button type="button" aria-label="Rafraîchir" title="Rafraîchir" class="flex items-center gap-2 min-h-11 px-3 sm:px-4 rounded-md text-base font-body font-medium border bg-surface text-ink border-hairline cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="hidden sm:inline">Rafraîchir</span></button></div></div></div><div class="px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6 overflow-y-auto"><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Plateforme</h2><p class="font-body text-sm text-muted-foreground mb-3">Mesuré à l'instant, côté serveur — ce n'est pas ce que le dépôt déclare, c'est ce que la base répond. Comptes exacts et non estimations du planificateur : sur des tables de cette taille, l'estimation peut être fausse de moitié.</p><div data-testid="plateforme"><div class="bg-surface rounded-lg border border-hairline shadow-sm p-5"><dl class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4"><div><dt class="font-body text-sm text-muted-foreground truncate">Collecteurs</dt><dd class="font-headings font-bold text-lg text-ink tabular-nums">42</dd></div><div><dt class="font-body text-sm text-muted-foreground truncate">Lignes de journal</dt><dd class="font-headings font-bold text-lg text-ink tabular-nums">1284</dd></div></dl><p class="font-body text-sm font-semibold text-ink mt-5 mb-2">Tables journalisées</p><p class="font-body text-xs text-muted-foreground mb-2">Lu dans <code>pg_trigger</code> : c'est la configuration en vigueur, pas une liste écrite à la main qui deviendrait fausse à la première migration. Le journal est en écriture seule — un déclencheur refuse toute modification, y compris par la clé de service.</p><div class="flex flex-wrap gap-2"><span class="px-2.5 py-1 rounded-pill text-xs font-body font-medium bg-positive-tint text-positive">collecteurs</span><span class="px-2.5 py-1 rounded-pill text-xs font-body font-medium bg-positive-tint text-positive">admins</span></div><p class="font-body text-sm text-muted-foreground mt-4">PostgreSQL 15.8 · dernière écriture au journal 30/08/2026 07:59:00</p></div></div></section></div>"`;

exports[`empreinte du rendu, avant et après le découpage > l’onglet promos rend exactement le même DOM 1`] = `"<div class="bg-canvas px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-4 flex-shrink-0"><div class="flex items-center gap-1.5 mb-2"><span class="flex items-center gap-1.5"><span class="text-sm font-body text-muted-foreground">Super Admin</span></span><span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="text-sm font-body text-ink font-medium">Promotions</span></span></div><div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"><h1 class="font-headings font-bold text-2xl sm:text-3xl text-ink">Codes promo &amp; Remises</h1><div class="flex items-center flex-wrap gap-2"><button type="button" aria-label="Rafraîchir" title="Rafraîchir" class="flex items-center gap-2 min-h-11 px-3 sm:px-4 rounded-md text-base font-body font-medium border bg-surface text-ink border-hairline cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="hidden sm:inline">Rafraîchir</span></button></div></div></div><div class="px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6 overflow-y-auto"><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Codes promo</h2><p class="font-body text-sm text-muted-foreground mb-3">Un code réduit le prix du palier d'un collecteur jusqu'à sa date de fin. Seul le Super Admin l'applique : le collecteur ne saisit rien.</p><div class="bg-surface rounded-lg border border-hairline shadow-sm divide-y divide-hairline mb-4"><div data-testid="code-RENTREE" class="p-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"><div class="min-w-0"><p class="font-body font-semibold text-ink">RENTREE<span class="ml-2 font-normal text-muted-foreground">−30 %</span></p><p class="font-body text-sm text-muted-foreground">du 1 août 2026 au 30 sept. 2026</p></div><div class="flex items-center gap-3 flex-shrink-0"><span class="font-body text-sm text-ink tabular-nums">12 / 50</span><span class="px-2.5 py-1 rounded-pill text-xs font-body font-semibold whitespace-nowrap bg-positive-tint text-positive">En cours</span></div></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-4"><div class="bg-surface rounded-lg border border-hairline shadow-sm p-5"><h3 class="font-headings font-bold text-base text-ink mb-3">Créer un code</h3><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label for="promo-code" class="block font-body text-sm font-semibold text-ink mb-1">Code</label><input id="promo-code" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary" value=""></div><div><label for="promo-remise" class="block font-body text-sm font-semibold text-ink mb-1">Remise (%)</label><input id="promo-remise" min="1" max="100" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary" type="number" value=""></div><div><label for="promo-du" class="block font-body text-sm font-semibold text-ink mb-1">Valide du</label><input id="promo-du" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary" type="date" value=""></div><div><label for="promo-au" class="block font-body text-sm font-semibold text-ink mb-1">Au</label><input id="promo-au" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary" type="date" value=""></div><div><label for="promo-quota" class="block font-body text-sm font-semibold text-ink mb-1">Quota (vide = illimité)</label><input id="promo-quota" min="1" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary" type="number" value=""></div></div><div class="mt-4"><button type="button" disabled="" class="anim-pression min-h-11 px-5 rounded-md font-body font-semibold text-base flex items-center justify-center gap-2 bg-primary text-primary-foreground border border-primary  opacity-50 cursor-default "><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Créer le code</button></div></div><div class="bg-surface rounded-lg border border-hairline shadow-sm p-5"><h3 class="font-headings font-bold text-base text-ink mb-3">Appliquer un code à un collecteur</h3><div class="flex flex-col gap-3"><div><label for="promo-collecteur" class="block font-body text-sm font-semibold text-ink mb-1">Collecteur</label><select id="promo-collecteur" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary cursor-pointer"><option value="">Choisir…</option><option value="22222222-2222-4222-8222-222222222222">Bakary Touré</option><option value="ccc">Chantal Yao</option></select></div><div><label for="promo-applique" class="block font-body text-sm font-semibold text-ink mb-1">Code à appliquer</label><select id="promo-applique" class="w-full min-h-11 px-3 bg-surface border border-hairline rounded-md font-body text-champ text-ink outline-none focus:border-primary cursor-pointer"><option value="">Choisir…</option><option value="RENTREE">RENTREE (−30 %)</option></select></div><div><button type="button" disabled="" class="anim-pression min-h-11 px-5 rounded-md font-body font-semibold text-base flex items-center justify-center gap-2 bg-primary text-primary-foreground border border-primary  opacity-50 cursor-default ">Appliquer</button></div></div></div></div></section><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Remises en cours</h2><p class="font-body text-sm text-muted-foreground mb-3">Ce que la plateforme offre aujourd'hui. Une remise échue disparaît d'ici : elle n'est plus une dépense, elle appartient au journal.</p><div class="bg-surface rounded-lg border border-hairline shadow-sm divide-y divide-hairline"><div data-testid="remise-22222222-2222-4222-8222-222222222222" class="p-4 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between"><p class="font-body font-semibold text-ink truncate">Bakary Touré</p><p class="font-body text-sm text-muted-foreground"><span class="font-semibold text-ink">RENTREE</span> · <span class="text-ink">−30 %</span> · jusqu'au 30 sept. 2026</p></div></div></section></div>"`;

exports[`empreinte du rendu, avant et après le découpage > l’onglet securite rend exactement le même DOM 1`] = `"<div class="bg-canvas px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-4 flex-shrink-0"><div class="flex items-center gap-1.5 mb-2"><span class="flex items-center gap-1.5"><span class="text-sm font-body text-muted-foreground">Super Admin</span></span><span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><span class="text-sm font-body text-ink font-medium">Sécurité</span></span></div><div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"><h1 class="font-headings font-bold text-2xl sm:text-3xl text-ink">Journal de sécurité</h1><div class="flex items-center flex-wrap gap-2"><button type="button" aria-label="Rafraîchir" title="Rafraîchir" class="flex items-center gap-2 min-h-11 px-3 sm:px-4 rounded-md text-base font-body font-medium border bg-surface text-ink border-hairline cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="hidden sm:inline">Rafraîchir</span></button></div></div></div><div class="px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6 overflow-y-auto"><section><h2 class="font-headings font-bold text-xl text-ink mb-1">Journal de sécurité</h2><p class="font-body text-sm text-muted-foreground mb-3">Qui a fait quoi, sur quelle ligne, et quand. Le journal est en écriture seule : un déclencheur refuse toute modification, y compris par la clé de service. <strong class="font-semibold text-ink">Le consulter s'enregistre</strong> — c'est pourquoi il ne s'affiche pas de lui-même.</p><div class="bg-surface rounded-lg border border-hairline shadow-sm p-5"><button type="button" class="anim-pression min-h-11 px-5 rounded-md font-body font-semibold text-base flex items-center justify-center gap-2 bg-primary text-primary-foreground border border-primary  cursor-pointer "><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>Afficher le journal</button></div></section></div>"`;
